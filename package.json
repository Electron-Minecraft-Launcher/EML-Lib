{
  "name": "eml-lib",
  "version": "2.7.2",
  "description": "Create your Electron Minecraft Launcher easily!",
  "author": "GoldFrite",
  "license": "MIT",
  "main": "index.js",
  "types": "index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "tsx test/test.ts",
