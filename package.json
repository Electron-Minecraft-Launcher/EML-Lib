  },
  "homepage": "https://emlproject.com/docs/",
  "dependencies": {
    "tslib": "^2.8.1",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "electron": "^44.0.0",
    "electron-updater": "^6.8.9",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "electron": ">=21.0.0",
    "electron-updater": ">=6.0.0"
  },
